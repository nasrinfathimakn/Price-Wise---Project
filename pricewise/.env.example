# ==============================================================
# PriceWise - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL.
# ==============================================================

# Application Profile
# Use 'local' for zero-config in-memory database or 'postgres' for PostgreSQL
SPRING_PROFILES_ACTIVE=local
PORT=8080

# PostgreSQL Database Configuration (used with 'postgres' profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricewise
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Security Configuration
# Must be at least a 256-bit (32 bytes) hex or base64 key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Amazon Product Advertising API (PA-API 5.0) Connector Configuration
# Requires Amazon Associates account & Creator / PA-API approved credentials
AMAZON_INTEGRATION_ENABLED=false
AMAZON_API_KEY=YOUR_AMAZON_ACCESS_KEY_ID
AMAZON_API_SECRET=YOUR_AMAZON_SECRET_ACCESS_KEY
AMAZON_ASSOCIATE_TAG=your-store-tag-21
AMAZON_API_ENDPOINT=https://webservices.amazon.in/paapi5

# Flipkart Affiliate API Connector Configuration
# Requires Flipkart Affiliate Partner account & API token
FLIPKART_INTEGRATION_ENABLED=false
FLIPKART_AFFILIATE_ID=YOUR_FLIPKART_AFFILIATE_ID
FLIPKART_AFFILIATE_TOKEN=YOUR_FLIPKART_AFFILIATE_TOKEN
FLIPKART_API_ENDPOINT=https://affiliate-api.flipkart.net/affiliate

# Price Synchronization Policy
SYNC_SCHEDULED_RATE_MS=3600000
FRESHNESS_THRESHOLD_HOURS=12

# Price Alert Notifications
ALERT_EVALUATION_RATE_MS=1800000
MAIL_CONFIGURED=false
MAIL_FROM=alerts@pricewise.local

